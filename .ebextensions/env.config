container_commands:
  01_storage_dirs:
    command: "mkdir -p /var/app/current/storage/framework/cache/data /var/app/current/storage/framework/sessions /var/app/current/storage/framework/views /var/app/current/storage/logs && chmod -R 775 /var/app/current/storage /var/app/current/bootstrap/cache"
  02_storage_link:
    command: "php /var/app/current/artisan storage:link || true"
  03_migrate:
    command: "php /var/app/current/artisan migrate --force || true"
  04_config_cache:
    command: "php /var/app/current/artisan config:cache && php /var/app/current/artisan route:cache && php /var/app/current/artisan view:cache"